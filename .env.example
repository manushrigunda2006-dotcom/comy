# ====================================================================
# Cherry – Norwegian Company Intelligence Agent
# Environment Configuration
# Copy this file to .env.local for local overrides
# ====================================================================

# --------------------------------------------------------------------
# Supabase Persistent Database Configuration
# --------------------------------------------------------------------
# Your Supabase project URL (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anonymous Key (safe for public/browser client usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (SECURE SERVER-SIDE ONLY)
# CRITICAL SECURITY RULE: NEVER expose this key to browser bundles or client code.
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------
# AI Provider API Keys (Optional - Cherry runs in verified Demo mode if unset)
# Supported keys: OPENAI_API_KEY, GEMINI_API_KEY, ANTHROPIC_API_KEY, or LLM_API_KEY
# --------------------------------------------------------------------
LLM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Search / Web Retrieval Provider (Optional - uses direct official registry fetchers when unset)
SEARCH_API_KEY=

# Local Database Store Fallback Path
DATABASE_URL=./data/signalpost.sqlite

# Application Environment
NODE_ENV=development
PORT=3000
